<nav class="navbar">
    <div class="container navbar-container">
        <a href="/" class="logo">
            <i class="ri-stack-line"></i>
            <%= typeof name !== 'undefined' ? name : 'CoreStack' %>
        </a>
        <button class="mobile-menu-btn">
            <i class="ri-menu-line"></i>
        </button>
        <div class="nav-links">
            <a href="/"> <%= __("home") || 'Inicio' %> </a>
            <a href="/#servicios"> <%= __("services") || 'Servicios' %> </a>
            <a href="/#proyectos"> <%= __("projects") || 'Proyectos' %> </a>
            <a href="/#testimonios"> <%= __("testimonials") || 'Testimonios' %> </a>
            <a href="/contact"> <%= __("contact_us") || 'Contacto' %> </a>
            <a href="/payment"> <%= __("payments") || 'Pagos' %> </a>
        </div>
        <form id="lang-form" action="" method="get">
          <select name="lang" id="lang" onchange="this.form.submit()">
            <option value="es" <%= (locale === 'es' ? 'selected' : '') %>>es</option>
            <option value="en" <%= (locale === 'en' ? 'selected' : '') %>>en</option>
          </select>
        </form>
        <a href="/contact" class="cta-button">
            <i class="ri-customer-service-line"></i>
            <%= __("emergency") || 'Soporte 24/7' %>
        </a>

        </div>
        <style>
        
        #lang-form {
        position: fixed;
        top: 1.1rem;
        right: 1.1rem;
        z-index: 1100;
      }

        #lang-form select {
        padding: 0.1rem 0.7rem;
        border-radius: 1.2rem;
        border: 1.5px solid #258add;
        font-size: 0.95rem;
        background: #258add;
        color: #fff;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        min-width: 2.5rem;
        text-align: center;
      }

      #lang-form select:focus {
        border-color: #1e5fa6;
        box-shadow: 0 0 0 2px #258add33;
      }
      
      @media (max-width: 768px) {
            .cta-button {
            display: none;
          }
          
          #lang-form {
          position: static;
          display: flex;
          align-items: center;
          margin-left: 0.5rem;
          margin-right: 0.5rem;
          z-index: auto;
        }
        }
        </style>
    </div>
</nav>