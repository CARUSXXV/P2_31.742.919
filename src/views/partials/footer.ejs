<div id="contacto" class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-section">
                <h3><%= __("Contacto") %></h3>
                <p><i class="ri-phone-fill"></i> <%= phone %></p>
                <p><i class="ri-mail-fill"></i> contacto@corestack.tech</p>
                <p><i class="ri-map-pin-fill"></i> San Juan de Los Morros, Estado Guárico, Venezuela</p>
            </div>
            <div class="footer-section">
                <h3><%= __("Certificaciones") %></h3>
                <p><i class="ri-check-line"></i> <%= __("Registro SAREN") %></p>
                <p><i class="ri-check-line"></i> <%= __("Código de Comercio Venezolano") %></p>
                <p><i class="ri-check-line"></i> <%= __("Capital Social Bs. 100.000,00") %></p>
                <p><i class="ri-check-line"></i> <%= __("Junta Directiva Técnica") %></p>
            </div>
            <div class="footer-section">
                <h3><%= __("Síguenos") %></h3>
                <div class="social-links">
                    <a href="https://www.facebook.com"><i class="ri-facebook-fill"></i></a>
                    <a href="https://www.instagram.com"><i class="ri-instagram-fill"></i></a>
                    <a href="https://www.linkedin.com"><i class="ri-linkedin-fill"></i></a>
                </div>
            </div>
        </div>
        <div style="text-align: center; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1)">
            <p>&copy; <%= new Date().getFullYear() %> CoreStack, C.A. <%= __("Todos los derechos reservados.") %></p>
        </div>
    </div>
</div>
