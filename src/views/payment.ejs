<!DOCTYPE html>
<html lang="es">
  <head>
    <% const ogTitle = 'Pago en línea - AquaRepair'; %>
    <% const ogDescription = 'Realiza tu pago de servicios de plomería de forma rápida y segura con AquaRepair.'; %>
    <% const ogImage = 'https://images.unsplash.com/photo-1581244277943-fe4a9c777189?auto=format&fit=crop&w=800&q=80'; %>
    <% const ogUrl = 'https://aquarepair.com/payment'; %>
    <%- include('partials/head', { ogTitle, ogDescription, ogImage, ogUrl, name }) %>
    <link rel="stylesheet" href="/css/payment-form.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <div class="form-container">
      <div class="form-card">
        <h2 class="form-title"><%= __("payments") %></h2>
        <% if (locals.success && paymentResult) { %>
        <div class="notification success">¡Pago procesado correctamente!</div>
        <% } %> <% if (locals.errors) { %>
                    <div class="notification error">
                        <% errors.forEach(function(error) { %>
                            <%= error.msg %>
                        <% }); %>
                    </div>
                <% } %>
                <% if (locals.success) { %>
                    <div class="notification success" id="success-notification">
                        <%= __("payment_success") %>
                    </div>
                <% } %>
        <form
          action="/payment/add"
          method="POST"
          id="payment-form"
          class="modern-form"
        >
          <div class="form-group">
            <label class="form-label"><%= __("service") || 'Servicio' %></label>
            <select
              name="service_id"
              required
              class="form-select"
              id="service-select"
            >
              <% if (locale === 'es') { %>
                <option value="1" data-amount="1500">Emergencias 24/7 - <%= formatCurrency(1500, 'es') %></option>
                <option value="2" data-amount="1000">Reparaciones Precisas - <%= formatCurrency(1000, 'es') %></option>
                <option value="3" data-amount="2000">Instalaciones Modernas - <%= formatCurrency(2000, 'es') %></option>
              <% } else { %>
                <option value="1" data-amount="150">24/7 Emergency - <%= formatCurrency(150, 'en') %></option>
                <option value="2" data-amount="100">Precision Repairs - <%= formatCurrency(100, 'en') %></option>
                <option value="3" data-amount="200">Modern Installations - <%= formatCurrency(200, 'en') %></option>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label"><%= __("email") || 'Correo electrónico' %></label>
            <div class="input-icon-wrapper">
              <i class="ri-mail-line"></i>
              <input type="email" name="email" required class="form-input" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label"><%= __("cardholder_name") || 'Nombre del titular' %></label>
            <div class="input-icon-wrapper">
              <i class="ri-user-line"></i>
              <input
                type="text"
                name="cardholder_name"
                required
                class="form-input"
              />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label"><%= __("card_number") || 'Número de tarjeta' %></label>
            <div class="input-icon-wrapper">
              <i class="ri-bank-card-line"></i>
              <input
                type="text"
                name="card_number"
                required
                pattern="[0-9]{16}"
                class="form-input"
                placeholder="1234567890123456"
              />
            </div>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label"><%= __("month") || 'Mes' %></label>
              <input
                type="number"
                name="expiry_month"
                required
                min="1"
                max="12"
                class="form-input"
                placeholder="MM"
              />
            </div>
            <div class="form-group">
              <label class="form-label"><%= __("year") || 'Año' %></label>
              <input
                type="number"
                name="expiry_year"
                required
                min="2024"
                class="form-input"
                placeholder="YYYY"
              />
            </div>
            <div class="form-group">
              <label class="form-label">CVV</label>
              <div class="input-icon-wrapper">
                <i class="ri-lock-line"></i>
                <input
                  type="text"
                  name="cvv"
                  required
                  pattern="[0-9]{3,4}"
                  class="form-input"
                  placeholder="123"
                />
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label"><%= __("currency") || 'Moneda' %></label>
            <select name="currency" required class="form-select">
              <% if (locale === 'es') { %>
                <option value="VES">VES</option>
              <% } %>
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
            </select>
          </div>
          <input type="hidden" name="amount" id="amount-input" value="150" />
          <button type="submit" class="form-button payment-button">
            <i class="ri-secure-payment-line"></i>
            <%= __("submit") || 'Realizar pago' %>
          </button>
        </form>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const serviceSelect = document.getElementById("service-select");
        const amountInput = document.getElementById("amount-input");

        // Set initial amount
        const initialAmount =
          serviceSelect.options[serviceSelect.selectedIndex].getAttribute(
            "data-amount"
          );
        amountInput.value = initialAmount;

        // Update amount when service changes
        serviceSelect.addEventListener("change", function (e) {
          const amount =
            e.target.options[e.target.selectedIndex].getAttribute(
              "data-amount"
            );
          amountInput.value = amount;
        });

        // Auto-hide notifications
        const notifications = document.querySelectorAll(".notification");
        notifications.forEach((notification) => {
          setTimeout(() => {
            notification.style.opacity = "0";
            setTimeout(() => {
              notification.style.display = "none";
            }, 500);
          }, 3500);
        });
      });
    </script>

    <%- include('partials/footer') %> <%- include('partials/scripts') %>
  </body>
</html>
