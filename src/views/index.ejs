<!DOCTYPE html>
<html lang="es">
<head>
    <% const ogTitle = 'AquaRepair - Soluciones de Plomería Profesional 24/7'; %>
    <% const ogDescription = 'Expertos en plomería, atención inmediata, servicios de emergencia y garantía total. ¡Contáctanos para resolver cualquier problema de agua!'; %>
    <% const ogImage = 'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=800&q=80'; %>
    <% const ogUrl = 'https://aquarepair.com'; %>
    <%- include('partials/head', { ogTitle, ogDescription, ogImage, ogUrl, name }) %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %> - Servicio de Plomería Profesional</title>
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/droplet.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/css/styles.css">

  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="container navbar-container">
        <a href="#" class="logo">
          <i class="ri-drop-line"></i>
          <%= name %>
        </a>
        <!-- Selector de idioma -->
        <form id="lang-form" action="" method="get">
          <select name="lang" id="lang" onchange="this.form.submit()">
            <option value="es" <%= (locale === 'es' ? 'selected' : '') %>>es</option>
            <option value="en" <%= (locale === 'en' ? 'selected' : '') %>>en</option>
          </select>
        </form>
        <button class="mobile-menu-btn">
          <i class="ri-menu-line"></i>
        </button>
        <div class="nav-links">
          <a href="#inicio"><%= __("Inicio") %></a>
          <a href="#servicios"><%= __("Servicios") %></a>
          <a href="#proyectos"><%= __("Proyectos") %></a>
          <a href="#testimonios"><%= __("Testimonios") %></a>
          <a href="#preguntas"><%= __("FAQ") %></a>
          <a href="#contacto"><%= __("Contacto") %></a>
        </div>
        <a href="tel:+584120367234" class="cta-button emergency-contact">
          <i class="ri-phone-line"></i>
          <%= __("Emergencias 24/7") %>
        </a>
      </div>
    </nav>
    <style>
      #lang-form {
        position: fixed;
        top: 1.1rem;
        right: 1.1rem;
        z-index: 1100;
      }
      #lang-form select {
        padding: 0.1rem 0.7rem;
        border-radius: 1.2rem;
        border: 1.5px solid #258add;
        font-size: 0.95rem;
        background: #258add;
        color: #fff;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        min-width: 2.5rem;
        text-align: center;
      }
      @media (max-width: 768px) {
        #lang-form {
          position: static;
          display: flex;
          align-items: center;
          margin-left: 0.5rem;
          margin-right: 0.5rem;
          z-index: auto;
        }
      }
      #lang-form select:focus {
        border-color: #1e5fa6;
        box-shadow: 0 0 0 2px #258add33;
      }
    </style>

    <!-- Hero Section -->
    <section id="inicio" class="hero">
      <video class="hero-video" autoplay loop muted playsinline>
        <source src="/videos/mujer-fontanero.webm" type="video/webm" />
        <source src="/videos/mujer-fontanero.mp4" type="video/mp4" />
        Tu navegador no soporta la reproducción de videos.
      </video>
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <h1><%= __("Soluciones de Plomería Profesional") %></h1>
        <p>
          <%= __("Expertos disponibles 24/7 para resolver cualquier emergencia con la máxima calidad y eficiencia") %>
        </p>
        <a href="/contact" class="cta-button">
          <i class="ri-customer-service-line"></i>
          <%= __("Solicitar Servicio") %>
        </a>
        <a href="/payment" class="cta-button" style="background: linear-gradient(45deg, #00c853, #64dd17)">
          <i class="ri-secure-payment-line"></i>
          <%= __("Pagar Servicio") %>
      </a>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="container">
        <div class="features-grid">
          <% features.forEach(function(feature) { %>
          <div class="feature-card" data-aos="fade-up">
            <i class="ri-<%= feature.icon %>-line"></i>
            <h3><%= __(feature.title) %></h3>
            <p><%= __(feature.description) %></p>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="services">
      <div class="container">
        <div class="section-title" data-aos="fade-up">
          <h2><%= __("Nuestros Servicios") %></h2>
          <p><%= __("Soluciones profesionales para todas tus necesidades") %></p>
        </div>
        <div class="services-grid">
          <% services.forEach(function(service, index) { %>
          <div
            class="service-card"
            data-aos="fade-up"
            data-aos-delay="<%= index * 100 %>"
          >
            <div class="service-image">
              <img src="<%= service.image %>" alt="<%= service.title %>" />
            </div>
            <div class="service-content">
              <h3><%= __(service.title) %></h3>
              <p><%= __(service.description) %></p>
              <div class="service-details">
                <ul>
                  <% service.details.forEach(function(detail) { %>
                  <li>
                    <i class="ri-check-line"></i>
                    <%= __(detail) %>
                  </li>
                  <% }); %>
                </ul>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="proyectos" class="projects">
      <div class="container">
        <div class="section-title" data-aos="fade-up">
          <h2><%= __("Proyectos Destacados") %></h2>
          <p><%= __("Conoce algunos de nuestros trabajos más relevantes") %></p>
        </div>
        <div class="projects-grid">
          <% projects.forEach(function(project) { %>
          <div class="project-card" data-aos="fade-up">
            <img
              src="<%= project.image %>"
              alt="<%= project.title %>"
              class="project-image"
            />
            <div class="project-overlay">
              <h3><%= __(project.title) %></h3>
              <p><%= __(project.description) %></p>
              <span class="project-category"><%= __(project.category) %></span>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <% stats.forEach(function(stat) { %>
          <div class="stat-item" data-aos="fade-up">
            <h3 class="floating"><%= stat.number %></h3>
            <p><%= __(stat.label) %></p>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonios" class="testimonials">
      <div class="container">
        <div class="section-title" data-aos="fade-up">
          <h2><%= __("Lo que dicen nuestros clientes") %></h2>
          <p><%= __("Testimonios de clientes satisfechos") %></p>
        </div>
        <div class="swiper testimonials-slider" data-aos="fade-up">
          <div class="swiper-wrapper">
            <% testimonials.forEach(function(testimonial) { %>
            <div class="swiper-slide">
              <div class="testimonial-card">
                <div class="testimonial-image">
                  <img
                    src="<%= testimonial.image %>"
                    alt="<%= testimonial.author %>"
                  />
                </div>
                <p>"<%= __(testimonial.text) %>"</p>
                <div class="testimonial-author"><%= testimonial.author %></div>
                <div class="testimonial-rating">
                  <% for(let i = 0; i < testimonial.rating; i++) { %>
                  <i class="ri-star-fill" style="color: #ffd700"></i>
                  <% } %>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <div class="swiper-pagination"></div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="preguntas" class="faq">
      <div class="container">
        <div class="section-title" data-aos="fade-up">
          <h2><%= __("Preguntas Frecuentes") %></h2>
          <p><%= __("Resolvemos tus dudas") %></p>
        </div>
        <div class="faq-grid">
          <% faqs.forEach(function(faq) { %>
          <div class="faq-item" data-aos="fade-up">
            <div class="faq-question"><%= __(faq.question) %></div>
            <div class="faq-answer"><%= __(faq.answer) %></div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    
    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container" data-aos="fade-up">
        <h2><%= __("¿Necesitas ayuda urgente?") %></h2>
        <p><%= __("Estamos disponibles 24/7 para atender tu emergencia") %></p>
        <a href="/contact"  class="cta-button cta-button-call">
          <i class="ri-phone-line"></i>
          <%= __("¡Contáctanos ahora!") %>
        </a>
        <a href="/payment" class="cta-button" style="background: linear-gradient(45deg, #00c853, #64dd17);">
          <i class="ri-secure-payment-line"></i>
          <%= __("Pagar Online") %>
      </a>
      </div>
    </section>

    <!-- Footer -->
    <footer id="contacto" class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-section">
            <h3><%= __("Contacto") %></h3>
            <p><i class="ri-phone-fill"></i> <%= phone %></p>
            <p><i class="ri-mail-fill"></i> <%= email %></p>
            <p><i class="ri-map-pin-fill"></i> <%= address %></p>
          </div>
          <div class="footer-section">
            <h3><%= __("Certificaciones") %></h3>
            <% certifications.forEach(function(cert) { %>
            <p><i class="ri-check-line"></i> <%= __(cert) %></p>
            <% }); %>
          </div>
          <div class="footer-section">
            <h3><%= __("Síguenos") %></h3>
            <div class="social-links">
              <a href="https://www.facebook.com"><i class="ri-facebook-fill"></i></a>
              <a href="https://www.instagram.com"><i class="ri-instagram-fill"></i></a>
              <a href="https://www.whatsapp.com"><i class="ri-whatsapp-fill"></i></a>
            </div>
          </div>
        </div>
        <div
          style="
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
          "
        >
          <p>
            &copy; <%= new Date().getFullYear() %> <%= name %>. <%= __("Todos los derechos reservados.") %>
          </p>
        </div>
      </div>
    </footer>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script> 
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>

      // Inicializar AOS (Animaciones De Scroll)
      AOS.init({ 
        duration: 1000, // 1 Segundo
        once: true, // Solo se ejecuta 1 vez
        offset: 100, // La animación comienza cuando el elemento está a 100 píxeles de distancia del viewport
      });

      // Inicializar Swiper
      new Swiper(".testimonials-slider", {
        slidesPerView: 1,
        spaceBetween: 30,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        breakpoints: {
          768: {
            slidesPerView: 2,
          },
          1024: {
            slidesPerView: 3,
          },
        },
        autoplay: {
          delay: 5000,
        },
      });

      // Efecto de scroll en la Navbar
      window.addEventListener("scroll", () => {
        const navbar = document.querySelector(".navbar");
        if (window.scrollY > 50) {
          navbar.classList.add("scrolled");
        } else {
          navbar.classList.remove("scrolled");
        }
      });

      // Menú Móvil
      const mobileMenuBtn = document.querySelector(".mobile-menu-btn");
      const navLinks = document.querySelector(".nav-links");

      mobileMenuBtn.addEventListener("click", () => {
        navLinks.classList.toggle("active");
      });

      // Desplazamiento Suave
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute("href"));
          if (target) {
            target.scrollIntoView({
              behavior: "smooth",
            });
            // Cierra el menú móvil si está abierto
            navLinks.classList.remove("active");
          }
        });
      });
    </script>
  </body>
</html>
